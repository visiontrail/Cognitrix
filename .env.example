# Docker Compose deployment defaults for a near-production local/test-machine stack.
# Copy to .env or run scripts/docker_start.sh; the script creates .env when missing.

# Public endpoints exposed on the host.
API_PORT=8000
WEB_PORT=3000
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Core runtime.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/uploads/state/ai_views.sqlite3
UPLOAD_DIR=/app/data/uploads

# LLM provider.
MODEL_PROVIDER_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=120
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-chat
API_TIMEOUT_MS=600000

# Agent runtime.
CLAUDE_AGENT_SDK_ENABLED=true
AGENTIC_INGESTION_ENABLED=false
LEGACY_DATASET_UPLOAD_ENABLED=true
AGENT_MAX_TOOL_STEPS=20
AGENT_MAX_SQL_ROWS=2000
AGENT_MAX_SQL_SCAN_ROWS=10000
AGENT_TIMEOUT_SECONDS=120
INGESTION_PLAN_TIMEOUT_SECONDS=600

# Auth and accounts. Override secrets before using on a shared test machine.
AUTH_SECRET=replace-with-a-strong-secret
NEXTAUTH_SECRET=replace-with-a-strong-secret
USER_ACCOUNTS_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_TTL_MIN=120
INVITE_LINK_TTL_DAYS=14
LEGACY_SERVICE_LOGIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=

# Optional agent-skills admin surface.
AGENT_SKILLS_ENABLED=false
AGENT_SKILLS_DIR=
AGENT_SKILLS_MAX_UPLOAD_MB=25
LEGACY_XLSX_PARSER_ENABLED=true

# Web server-to-server API target inside the compose network.
API_BASE_URL=http://api:8000
