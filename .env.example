# ==============================================================================
# 本文件是模板，不含任何真实密钥，直接复制成 .env 无法安全上线。
#
# 服务器部署请勿手工拷贝本文件，执行:  bash scripts/deploy.sh
# 该脚本会生成随机 AUTH_SECRET / NEXTAUTH_SECRET 与随机超管口令，构建启动整个
# 栈，并在结束时打印访问地址与登录凭据。模型 Key 等运行时配置登录后在管理后台
# /admin 里填即可。详见 deploy/README.md。
# ==============================================================================

# ------------------------------------------------------------------------------
# 镜像发布
# 仅 scripts/docker_publish.sh 使用（cognitrix-api:${TAG} / cognitrix-web:${TAG}）。
# docker-compose.yml 走本地 build，不读该值。
# ------------------------------------------------------------------------------
TAG=1.0.7

# ------------------------------------------------------------------------------
# 应用与运行环境
# 注意: docker-compose.yml 把 APP_NAME 硬编码为 "Cognitrix API"，此处的值对容器无效，
#       仅在非 Docker（make dev-api）直跑时生效。
# ------------------------------------------------------------------------------
APP_NAME=CongniTrix
APP_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 对外端口与站点地址
# ------------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
APP_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ------------------------------------------------------------------------------
# 存储路径（容器内绝对路径）
# docker-compose.yml 对这两个键做了硬编码覆盖，容器内始终是下面这两个值；
# 这里写成一致的绝对路径，避免误以为相对路径 ./data/uploads 生效。
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/uploads/state/ai_views.sqlite3
UPLOAD_DIR=/app/data/uploads
# 写操作在 SQLite 文件被占用时的最长等待时间（毫秒），超时才报 database is locked。
SQLITE_BUSY_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 镜像构建期的软件源（内网/弱网时保留重试参数）
# PIP_INDEX_URL 留空走官方 PyPI。claude-agent-sdk 自带 CLI 二进制、wheel 有数百 MB，
# 内网构建务必指向私有源，否则大概率超时。
# ------------------------------------------------------------------------------
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmmirror.com
NPM_FETCH_RETRIES=5
NPM_FETCH_RETRY_MINTIMEOUT=20000
NPM_FETCH_RETRY_MAXTIMEOUT=120000
NPM_FETCH_TIMEOUT=600000
NPM_HTTP_PROXY=
NPM_HTTPS_PROXY=

# ------------------------------------------------------------------------------
# 模型供应商
# ANTHROPIC_AUTH_TOKEN 留空时，代码自动回退使用 AI_API_KEY（apps/api/agent_runtime.py:323）。
# 服务器部署不必在此填写: 留空同样能启动，登录后在管理后台 /admin →「模型设置」
# 填入即可，保存后立即生效、无需重启。填好之前所有对话都会失败，属预期行为。
# ------------------------------------------------------------------------------
MODEL_PROVIDER_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_TIMEOUT_SECONDS=120
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
API_TIMEOUT_MS=600000

# ------------------------------------------------------------------------------
# Agent 运行时
# ------------------------------------------------------------------------------
CLAUDE_AGENT_SDK_ENABLED=true
AGENTIC_INGESTION_ENABLED=true
LEGACY_DATASET_UPLOAD_ENABLED=true
AGENT_MAX_TOOL_STEPS=20
AGENT_MAX_SQL_ROWS=2000
AGENT_MAX_SQL_SCAN_ROWS=10000
AGENT_TIMEOUT_SECONDS=240
INGESTION_PLAN_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# 联网检索（web_search / web_fetch / save_web_research）
# ------------------------------------------------------------------------------
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_MAX_CALLS_PER_TURN=5
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_CHARS=20000

# ------------------------------------------------------------------------------
# 鉴权与账号
# AUTH_SECRET / NEXTAUTH_SECRET 必须是本机独有的随机值：任何写进仓库的值都等同
# 公开，持有者可以伪造任意角色的 JWT。此处一律留空，由 scripts/deploy.sh 生成；
# 手工填写用 `openssl rand -hex 32`。更换后现有 token 全部失效（需重新登录）。
# ------------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_SECRET=
USER_ACCOUNTS_ENABLED=true
# 生产环境开放自助注册 = 任何能访问该地址的人都能建号，内网部署请评估后决定
AUTH_REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=8
# 43200 分钟 = 30 天。系统没有 token 吊销机制，泄露后只能靠改 AUTH_SECRET 全量失效
ACCESS_TOKEN_TTL_MIN=43200
INVITE_LINK_TTL_DAYS=14
# POST /auth/login 是无凭据的服务令牌登录: 请求里写什么 role 就发什么 role 的
# token，包括 superadmin。仅供本地开发与 smoke 使用。默认关闭；且 APP_ENV=production
# 时无论此开关为何值都强制关闭（返回 404）。生产环境不要指望靠它登录。
LEGACY_SERVICE_LOGIN_ENABLED=false

# 首启引导账号: 仅当库中还没有任何密码账号时才会创建；之后再补只能促成已存在用户
# 的超管提权，无法凭空建号。口令留空不是"禁用"，而是【自动生成一个随机口令并打进
# 日志】（横幅关键字 BOOTSTRAP ADMIN，仅创建时出现一次）；scripts/deploy.sh 则会
# 预先生成并在部署结束时打印。要完全禁用自动建号，把 EMAIL 显式设为空。
# 系统没有硬编码的默认口令 —— 那种口令对所有能读代码的人公开。首登请立即改密。
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@cognitrix.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=admin@cognitrix.local

# ------------------------------------------------------------------------------
# Agent Skills（超级管理员，/admin/skills）
# 置 true 后 xlsx skill 才会 bootstrap；届时可把 LEGACY_XLSX_PARSER_ENABLED 改 false
# ------------------------------------------------------------------------------
AGENT_SKILLS_ENABLED=false
AGENT_SKILLS_DIR=
AGENT_SKILLS_MAX_UPLOAD_MB=25
LEGACY_XLSX_PARSER_ENABLED=true

# ------------------------------------------------------------------------------
# compose 网络内 web -> api 的服务端调用地址
# 浏览器一律走同源代理 /api/backend（apps/web/lib/api-base.ts），不直连 8000
# ------------------------------------------------------------------------------
API_BASE_URL=http://api:8000

# ==============================================================================
# 后端扩展配置。docker-compose.yml 会将这些键透传给 api service；
# make dev-api 直跑时请在 apps/api/.env 中配置对应值。
# ==============================================================================
PUBLIC_BASE_URL=http://127.0.0.1:3000
AGENT_CANVAS_MODE_ENABLED=true
AGENT_MODE_MAX_STEPS=40
# 大纲规划阶段单独的步数预算（只影响 Agent 画布模式的第一阶段）。
AGENT_MODE_OUTLINE_MAX_STEPS=24
AGENT_MODE_TIMEOUT_SECONDS=600
AGENT_MODE_MAX_CHARTS=12
AGENT_MODE_MAX_PAGES=6
MULTI_CHART_GENERATION_ENABLED=true
AGENT_MAX_MULTI_CHARTS=8
MULTI_CHART_CONFIRMATION_TTL_SECONDS=900
PUBLIC_ASSISTANT_CACHE_TTL_SECONDS=1800
PUBLIC_ASSISTANT_CACHE_MAX_ENTRIES=10
PUBLIC_ASSISTANT_MAX_QUERY_ROWS=200
ADMIN_USAGE_RETENTION_DAYS=180
