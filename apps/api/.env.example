APP_NAME=Cognitrix API
APP_ENV=development
DATABASE_URL=sqlite:///./data/uploads/state/ai_views.sqlite3
# How long a write waits for a busy SQLite file before failing (milliseconds).
SQLITE_BUSY_TIMEOUT_MS=15000
MODEL_PROVIDER_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=120
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-chat
API_TIMEOUT_MS=600000
CLAUDE_AGENT_SDK_ENABLED=true
AGENTIC_INGESTION_ENABLED=false
LEGACY_DATASET_UPLOAD_ENABLED=true
AGENT_MAX_TOOL_STEPS=20
AGENT_MAX_SQL_ROWS=2000
AGENT_MAX_SQL_SCAN_ROWS=10000
AGENT_TIMEOUT_SECONDS=120
# Agent 画布模式（一句话生成整页仪表盘）总开关。默认 false：关闭时画布工具不注册、
# 不产生 canvas_op SSE 事件、系统提示词不变，存量行为零变化。
AGENT_CANVAS_MODE_ENABLED=false
# Agent 画布模式专用预算（与上面的问答限额相互独立）。
AGENT_MODE_MAX_STEPS=40
AGENT_MODE_TIMEOUT_SECONDS=600
AGENT_MODE_MAX_CHARTS=12
# 联网搜索总开关。默认 false，关闭时 web_search/web_fetch/save_web_research 三个工具
# 不注册、不进守卫白名单，存量行为零变化。设为 true 以启用联网检索能力。
WEB_SEARCH_ENABLED=false
# 搜索供应商：bocha（博查，中文场景更佳）| tavily（英文/备用）。
WEB_SEARCH_PROVIDER=bocha
# 搜索供应商 API 密钥（WEB_SEARCH_ENABLED=true 时必填）。
WEB_SEARCH_API_KEY=
# 单次搜索返回的结果条数上限。
WEB_SEARCH_MAX_RESULTS=8
# 单个对话轮次内 web_search+web_fetch 的调用总次数上限（守卫层计数）。
WEB_SEARCH_MAX_CALLS_PER_TURN=5
# 单次网页抓取超时（秒）。
WEB_FETCH_TIMEOUT_SECONDS=15
# 单次抓取响应体大小上限（字节，默认 2 MiB）。
WEB_FETCH_MAX_BYTES=2097152
# 进入模型上下文的正文截断长度（字符）。
WEB_FETCH_MAX_CHARS=20000
PUBLIC_ASSISTANT_CACHE_TTL_SECONDS=1800
PUBLIC_ASSISTANT_CACHE_MAX_ENTRIES=10
PUBLIC_ASSISTANT_MAX_QUERY_ROWS=200
INGESTION_PLAN_TIMEOUT_SECONDS=600
AUTH_SECRET=replace-with-a-strong-secret
USER_ACCOUNTS_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_TTL_MIN=120
INVITE_LINK_TTL_DAYS=14
LEGACY_SERVICE_LOGIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@cognitrix.local
# Development bootstrap only. The API rejects this documented password when
# APP_ENV=production. Override both values or set them empty to disable bootstrap.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
# Optional: promote a single account to the `superadmin` role on startup. If unset
# and AGENT_SKILLS_ENABLED=true, the bootstrap admin is auto-promoted on first run
# so the operator is never locked out of /admin/skills.
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=admin@cognitrix.local
# Master toggle for the agent-skills management surface (admin API + admin UI).
# Default false; flip to true to expose /admin/skills and load assigned skills
# into the Claude Agent SDK runtime.
AGENT_SKILLS_ENABLED=false
# Directory where validated skill bundles are extracted. Leave empty to default
# to ${UPLOAD_DIR}/agent_skills. Each installed skill lives under <skill_id>/.
AGENT_SKILLS_DIR=
# Maximum uploaded skill zip size in megabytes; rejected above this limit.
AGENT_SKILLS_MAX_UPLOAD_MB=25
# Retention window for metadata-only admin usage events.
ADMIN_USAGE_RETENTION_DAYS=180
# When true, ingestion keeps the legacy in-process xlsx parser as a fallback even
# if the xlsx skill is installed. Set false to force the skill-backed path.
LEGACY_XLSX_PARSER_ENABLED=true
APP_URL=http://localhost:3000
# Base URL used to build public publish links (/p/{token}). When empty, the
# link is built from the incoming request origin, then falls back to APP_URL.
# Set this to the externally reachable origin (e.g. https://share.example.com)
# when the API sits behind a proxy whose request host is not browser-reachable.
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
