APP_NAME=Cognitrix API
APP_ENV=development
DATABASE_URL=sqlite:///./data/uploads/state/ai_views.sqlite3
MODEL_PROVIDER_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=120
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-chat
API_TIMEOUT_MS=600000
CLAUDE_AGENT_SDK_ENABLED=true
AGENTIC_INGESTION_ENABLED=false
LEGACY_DATASET_UPLOAD_ENABLED=true
AGENT_MAX_TOOL_STEPS=20
AGENT_MAX_SQL_ROWS=2000
AGENT_MAX_SQL_SCAN_ROWS=10000
AGENT_TIMEOUT_SECONDS=120
AUTH_SECRET=replace-with-a-strong-secret
USER_ACCOUNTS_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_TTL_MIN=120
INVITE_LINK_TTL_DAYS=14
LEGACY_SERVICE_LOGIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: promote a single account to the `superadmin` role on startup. If unset
# and AGENT_SKILLS_ENABLED=true, the bootstrap admin is auto-promoted on first run
# so the operator is never locked out of /admin/skills.
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=
# Master toggle for the agent-skills management surface (admin API + admin UI).
# Default false; flip to true to expose /admin/skills and load assigned skills
# into the Claude Agent SDK runtime.
AGENT_SKILLS_ENABLED=false
# Directory where validated skill bundles are extracted. Leave empty to default
# to ${UPLOAD_DIR}/agent_skills. Each installed skill lives under <skill_id>/.
AGENT_SKILLS_DIR=
# Maximum uploaded skill zip size in megabytes; rejected above this limit.
AGENT_SKILLS_MAX_UPLOAD_MB=25
# When true, ingestion keeps the legacy in-process xlsx parser as a fallback even
# if the xlsx skill is installed. Set false to force the skill-backed path.
LEGACY_XLSX_PARSER_ENABLED=true
APP_URL=http://localhost:3000
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
